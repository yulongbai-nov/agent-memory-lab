{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-memory-lab/event-0.1.schema.json",
  "title": "Memory event proposal v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version","event_id","idempotency_key","kind","memory_id","scope","valid_time","observed_time","source_refs","payload"],
  "properties": {
    "schema_version": {"const":"0.1"},
    "event_id": {"type":"string","pattern":"^evt:[a-z0-9][a-z0-9-]*$"},
    "idempotency_key": {"type":"string","minLength":8,"maxLength":200},
    "kind": {"enum":["source","interpretation","correction","decision","change","resolution"]},
    "memory_id": {"type":"string","pattern":"^mem:[a-z0-9][a-z0-9-]*$"},
    "scope": {"type":"object","additionalProperties":false,"required":["owner","project"],"properties":{"owner":{"type":"string","minLength":1},"project":{"type":"string","minLength":1}}},
    "valid_time": {"type":"string","format":"date-time"},
    "observed_time": {"type":"string","format":"date-time"},
    "source_refs": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/sourceRef"}},
    "revises": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^evt:[a-z0-9][a-z0-9-]*$"}},
    "payload": {"type":"object","additionalProperties":false,"required":["text"],"properties":{"text":{"type":"string","minLength":1},"basis":{"enum":["confirmed","proposed","uncertain"]},"lifecycle":{"enum":["active","superseded","cancelled"]},"status":{"enum":["已确定","待决定","待核实","已替代","已取消"]}}}
  },
  "allOf": [
    {"if":{"properties":{"kind":{"enum":["correction","change","resolution"]}}},"then":{"required":["revises"]}},
    {"if":{"properties":{"kind":{"enum":["decision","change","resolution"]}}},"then":{"properties":{"payload":{"required":["basis","lifecycle","status"]}}}}
  ],
  "$defs": {"sourceRef":{"type":"object","additionalProperties":false,"required":["harness","session_id","source_version","message_ids","turn_range","captured_at","locator"],"properties":{
    "harness":{"type":"string","minLength":1},"session_id":{"type":"string","minLength":1},"source_version":{"type":"string","minLength":1},
    "message_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "turn_range":{"type":"array","prefixItems":[{"type":"integer","minimum":1},{"type":"integer","minimum":1}],"items":false,"minItems":2,"maxItems":2},
    "captured_at":{"type":"string","format":"date-time"},
    "locator":{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"enum":["native_url","archived_text","unavailable"]},"value":{"type":"string"}}}
  }}}
}
